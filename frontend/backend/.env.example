# Backend Environment Configuration Template
PORT=5000

# MongoDB Connection String (Atlas or Local)
# Example: mongodb+srv://<username>:<password>@cluster0.zvy0tmr.mongodb.net/gharbazaar?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.zvy0tmr.mongodb.net/?appName=Cluster0

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Image Upload Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
